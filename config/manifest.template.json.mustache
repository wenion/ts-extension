{
  "manifest_version": 3,
  "name": "Trace Capture Extension",
  "key": "",
  "description": "Trace Capture Extension",
  "version": "{{version}}",
  "externally_connectable": {
    "matches": {{{externally_connectable_matches}}}
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "{{{default_popup}}}"
  },
  "permissions": {{{permissions}}},
  "host_permissions": {{{host_permissions}}},
  "optional_permissions": {{{optional_permissions}}},
  "optional_host_permissions": {{{optional_host_permissions}}},
  "oauth2": {
    "client_id": "581953841566-98h7ul8o8jjn5th11cruft4vel9t9007.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/documents.readonly"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches":{{{web_accessible_matches}}}
    }
  ],
  "icons": {
    "48": "mag48.png",
    "128": "mag128.png"
  }
}