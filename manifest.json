{
  "manifest_version": 3,
  "name": "My TS Extension",
  "version": "1.0.0",
  "background": {
    "service_worker": "dist/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["dist/content-script/index.js"]
    }
  ],
  "permissions": ["storage", "tabs"]
}
